<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="PGlove — A browser with a new generation. Stable v1.0.3, Nighty builds, Codeberg mirror, Bitcoin donations.">
<meta name="theme-color" content="#0a0420">
<title>PGlove — A Browser With A New Generation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
/* ============================================================ */
/*   PGlove — Purple & Blue Theme · Complete Redesign            */
/* ============================================================ */
:root {
  --purple-100: #e6d9ff;
  --purple-200: #c9aaff;
  --purple-300: #ab7bff;
  --purple-400: #8b4dff;
  --purple-500: #6d28d9;
  --purple-600: #5b21b6;
  --purple-700: #4c1d95;
  --blue-400: #60a5fa;
  --blue-500: #3b82f6;
  --blue-600: #2563eb;
  --cyan-300: #67e8f9;
  --cyan-400: #22d3ee;
  --cyan-500: #06b6d4;
  --bg-0: #05010f;
  --bg-1: #0a0420;
  --bg-2: #12063a;
  --surface: #140a38;
  --surface-2: #1e1054;
  --border: rgba(139, 77, 255, 0.18);
  --border-strong: rgba(139, 77, 255, 0.35);
  --text: #e8e4f5;
  --text-dim: #b8aee0;
  --text-muted: #7a6fa5;
  --green: #10b981;
  --green-light: #34d399;
  --yellow: #ffcb05;
  --orange: #fb923c;
  --pink: #f472b6;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

/* Extensions Section */
.extension-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-top: 2rem;
  padding: 1.5rem;
  background: var(--bg-2);
  border-radius: 12px;
  border: 1px solid var(--border-strong);
}
.extension-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: 'Inter', sans-serif;
  color: var(--text);
}
.extension-icon {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
}
.extension-name {
  font-weight: 600;
  font-size: 0.95rem;
}
.extension-badge {
  font-size: 0.7rem;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  background: var(--purple-500);
  color: #fff;
  font-weight: 600;
}

/* Download Section */
.download-section { background: linear-gradient(180deg, transparent, rgba(30, 16, 84, 0.3) 50%, transparent); }

section { margin-bottom: 3rem; }

.version-card { border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; min-width: 280px; }
.version-card.featured { border-left: 4px solid var(--blue-500); }
.version-card.nuget-card { border-left: 4px solid var(--purple-500); }
.version-card.nighty-card { border-left: 4px solid var(--pink); }
.version-card.winget-card { border-left: 4px solid var(--orange); }

.code-block { background: var(--bg-1); padding: 0.75rem; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; line-height: 1.6; }

footer-note { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
</style>
</head>
<body>

<h1>PGlove — A Browser With A New Generation</h1>

<!-- Download Grid -->
<div class="section download-section" id="download">
  <div class="section-inner reveal">
    <div class="section-header">
      <div class="section-tag"><i class="fas fa-download"></i> Get PGlove</div>
      <h2 class="section-title">Choose your <span class="grad">build.</span></h2>
      <p class="section-sub">Choose between the stable release, experimental builds, or the core library.</p>
    </div>

    <div class="versions-grid">
      <!-- Stable -->
      <div class="version-card featured">
        <span class="version-label v-stable">✅ Stable</span>
        <div class="version-name">📦 Stable Release</div>
        <div class="version-desc">Version 1.0.3 • Production ready</div>
        <div class="code-block">npm install @techadityabro/pglove-stable</div>
        <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:1rem;">Package: @techadityabro/pglove-stable • Registry: GitHub Packages</div>
        <div class="version-actions">
          <a href="https://github.com/TechAdityaBRO/PGlove/pkgs/npm/pglove-stable" target="_blank" rel="noopener" class="btn btn-green btn-sm"><i class="fas fa-box"></i> View NPM Package</a>
          <a href="https://github.com/TechAdityaBRO/PGlove/releases" target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><i class="fas fa-link"></i> View Releases</a>
        </div>
      </div>

      <!-- NuGet -->
      <div class="version-card nuget-card">
        <span class="version-label v-nuget">🔷 NuGet</span>
        <div class="version-name">📦 PGloveCore</div>
        <div class="version-desc">Version 1.0.3 • Core metadata helpers</div>
        <div class="code-block">dotnet add package PGloveCore</div>
        <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:1rem;">Package: PGloveCore • .NET Library</div>
        <div class="version-actions">
          <a href="https://github.com/TechAdityaBRO/PGlove/pkgs/nuget/PGloveCore" target="_blank" rel="noopener" class="btn btn-primary btn-sm"><i class="fas fa-cube"></i> View NuGet Package</a>
          <a href="https://www.nuget.org/" target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><i class="fas fa-info-circle"></i> About NuGet</a>
        </div>
      </div>

      <!-- Nighty -->
      <div class="version-card nighty-card">
        <span class="version-label v-nighty">🌙 Nighty</span>
        <div class="version-name">⚡ Nighty Build</div>
        <div class="version-desc">Version 1.0.2-Nighty • Unstable & experimental</div>
        <div class="code-block">PGlove-Installers.exe (8.7 MB)</div>
        <div class="version-actions">
          <a href="https://archive.org/download/pglove-installers/PGlove-Installers.exe" target="_blank" rel="noopener" class="btn btn-orange btn-sm"><i class="fas fa-download"></i> Download from Archive</a>
          <a href="https://progroupco.itch.io/pglove" target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><i class="fab fa-itch-io"></i> Also on Itch.io</a>
        </div>
      </div>

      <!-- Winget -->
      <div class="version-card winget-card">
        <span class="version-label v-winget">⚡ Winget</span>
        <div class="version-name">⚡ Winget</div>
        <div class="version-desc">Windows Package Manager (CLI)</div>
        <div class="code-block">winget install TechAditya.PGlove</div>
        <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:1rem;">Silent: /s • SilentWithProgress: /SILENT</div>
        <div class="version-actions">
          <a href="https://github.com/microsoft/winget-pkgs/pull/421311" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><i class="fas fa-terminal"></i> View Winget PR</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Extensions Section -->
  <section class="extension-list">
    <h2 class="section-title">Available Extensions</h2>
    <div class="extension-item">
      <div class="extension-icon"><i class="fas fa-chrome"></i></div>
      <span class="extension-name">Chrome / Edge / Opera</span>
      <span class="extension-badge">🖥️</span>
    </div>
    <div class="extension-item">
      <div class="extension-icon"><i class="fas fa-firefox"></i></div>
      <span class="extension-name">Firefox</span>
      <span class="extension-badge">🌍</span>
    </div>
    <div class="extension-item">
      <div class="extension-icon"><i class="fas fa-pale-moon"></i></div>
      <span class="extension-name">Firefox (Pale Moon)</span>
      <span class="extension-badge">🎨</span>
    </div>
    <div class="extension-item">
      <div class="extension-icon"><i class="fas fa-windmill"></i></div>
      <span class="extension-name">Winget (Windows Package Manager)</span>
      <span class="extension-badge">💨</span>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="section" id="roadmap">
    <div class="section-inner reveal">
      <div class="section-header">
        <div class="section-tag"><i class="fas fa-road"></i> What's Next</div>
        <h2 class="section-title">What's <span class="grad">Next</span> for PGlove?</h2>
        <p class="section-sub">We're constantly evolving. Here's what we're working on for future releases.</p>
      </div>
    </div>
  </section>

</body>
</html>
